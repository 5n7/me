---
import ExperienceRow from "../components/ExperienceRow.astro";
import LedgerLink from "../components/LedgerLink.astro";
import Rail from "../components/Rail.astro";
import { heroHighlights, portfolio } from "../data/portfolio.ts";
import Base from "../layouts/Base.astro";
import { isJapanese } from "../lib/format.ts";
import "../styles/portfolio.css";

const roles = portfolio.roles.join(" · ");
const interests = portfolio.interests.join(" / ");
const langValue = portfolio.languages
	.map((l) => `${l.name} (${l.level})`)
	.join(" · ");

// Single source of truth for section numbering: the hero contents nav and
// each section's <Rail> both derive from this list.
const sections = [
	{ id: "now", idx: "02", label: "Now" },
	{ id: "about", idx: "03", label: "About" },
	{ id: "experience", idx: "04", label: "Experience" },
	{ id: "education", idx: "05", label: "Education" },
	{ id: "talks", idx: "06", label: "Talks" },
	{ id: "writing", idx: "07", label: "Writing" },
	{ id: "awards", idx: "08", label: "Awards" },
	{ id: "contact", idx: "09", label: "Contact" },
];

const rail = (id: string): { idx: string; label: string } => {
	const s = sections.find((sec) => sec.id === id);
	if (!s) throw new Error(`Unknown section id: ${id}`);
	return { idx: s.idx, label: s.label };
};

const buildDate = __BUILD_DATE__;
const commit = __COMMIT_HASH__;
const year = buildDate.slice(0, 4);
---

<Base>
  <a class="skip" href="#main">Skip to content</a>

  <header class="hero">
    <p class="hero-topline">
      <span class="wordmark">5n7.me</span>
      <span>Tokyo · UTC+09:00 · ja / en · <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Switch theme"
        >
          <span data-theme-word="light">Light</span> / <span
            data-theme-word="dark"
          >Dark</span>
        </button></span>
    </p>

    <div class="hero-main">
      <h1 class="hero-name"><span>Shunta</span><span>Komatsu</span></h1>
      <figure class="hero-photo">
        <img
          src="/profile.webp"
          alt="Portrait of Shunta Komatsu"
          width="360"
          height="360"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>PORTRAIT — TOKYO 35.68°N 139.65°E</figcaption>
      </figure>
      <div class="hero-id">
        <p class="hero-tagline">
          {portfolio.taglineParts.map((part) => (
            <>{part}<span class="stop">.</span>{" "}</>
          ))}
        </p>
        <p class="hero-roles">{roles}</p>
      </div>
    </div>

    <hr class="rule-strong" />

    <div class="hero-foot">
      <nav class="hero-toc" aria-label="Contents">
        {sections.map((t) => (
          <a href={`#${t.id}`}><span>{t.idx}</span> {t.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main id="main">
    <section id="now" class="now">
      {heroHighlights.map((h) => (
        <div class="fact">
          <p class="fact-label">{h.label}</p>
          <p class="fact-value">
            {h.value}{h.valueAux && <> <span>{h.valueAux}</span></>}
          </p>
          <p class="fact-foot">{h.foot}</p>
        </div>
      ))}
    </section>

    <section id="about" class="section">
      <Rail {...rail("about")} />
      <div class="content content--about">
        <p class="prose">
          I build the payment platform behind Mercari's marketplace as an
          Engineering Manager at Merpay, leading two payment-core teams while
          still shipping code. On the side I run engineering at Yomoyama
          (real-estate price estimation) and RINGBELL (a marriage agency
          service). Trained in image processing (MSc, Tokyo University of
          Science); off the clock I photograph Tokyo and follow a corgi around
          it.
        </p>
        <p class="interests">{interests}</p>
        <dl class="vitals">
          <div class="vital">
            <dt>Born</dt>
            <dd>{portfolio.birthplace}</dd>
          </div>
          <div class="vital">
            <dt>Base</dt>
            <dd>{portfolio.location}</dd>
          </div>
          <div class="vital">
            <dt>Lang</dt>
            <dd>{langValue}</dd>
          </div>
        </dl>
      </div>
    </section>

    <section id="experience" class="section">
      <Rail {...rail("experience")} sticky />
      <div class="content">
        {portfolio.experience.map((e) => (
          <ExperienceRow
            role={e.role}
            org={e.org}
            range={e.range}
            body={e.body}
            tag={e.tag}
          />
        ))}
      </div>
    </section>

    <section id="education" class="section section--education">
      <Rail {...rail("education")} />
      <div class="content">
        {portfolio.education.map((e) => (
          <article class="ledger-row ledger-row--edu">
            <span class="ledger-date">{e.range}</span>
            <div class="ledger-body">
              <h3>
                <span class="role">{e.degree}</span> — <span
                  class="org"
                >{e.org}</span>
              </h3>
              <p>{e.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="talks" class="section">
      <Rail {...rail("talks")} sticky />
      <div class="content">
        {portfolio.talks.map((t) => (
          <LedgerLink
            date={t.date}
            title={t.title}
            venue={t.venue}
            venueHighlight={t.venueHighlight}
            href={t.href}
          />
        ))}
        {portfolio.academic.map((paper) => (
          <div class="ledger-row ledger-row--paper">
            <span class="ledger-date">
              <span class="paper-key">Paper</span>
              {paper.date}
            </span>
            <div class="ledger-body">
              <span
                class="title title--paper"
                lang={isJapanese(paper.title) ? "ja" : undefined}
              >{paper.title}</span>
              <span class="venue">{paper.venue}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="writing" class="section">
      <Rail {...rail("writing")} sticky />
      <div class="content">
        {portfolio.publications.map((p) => (
          <LedgerLink
            date={p.date}
            title={p.title}
            venue={p.venue}
            href={p.href}
          />
        ))}
      </div>
    </section>

    <section id="awards" class="section">
      <Rail {...rail("awards")} />
      <div class="content">
        {portfolio.awards.map((a) => (
          <div class="ledger-row ledger-row--award">
            <span class="ledger-date">{a.date}</span>
            <div class="ledger-body">
              <span class="award-title">{a.title}</span>
              <span class="award-org">{a.org}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <footer id="contact">
      <hr class="rule-strong" />
      <div class="contact-grid">
        <h2 class="contact-display">Get in touch</h2>
        <ul class="contact-links">
          {portfolio.links.map((l) => {
          	const external = l.href.startsWith("http");
          	return (
             <li>
               <a
                 href={l.href}
                 target={external ? "_blank" : undefined}
                 rel={external ? "noopener" : undefined}
               >
                 <span class="key">{l.label}</span>
                 <span class="val">{l.short}</span>
               </a>
             </li>
           );
          })}
        </ul>
      </div>
      <div class="colophon">
        <p>
          © {year} Shunta Komatsu · 5n7.me · built {buildDate} · {commit} · Set
          in Archivo, IBM Plex Mono &amp; Noto Sans JP · Astro
          <span class="end-mark" aria-hidden="true"></span>
        </p>
      </div>
    </footer>
  </main>

  <script is:inline>
  // Theme toggle. Effective theme = stored choice, else OS preference; a
// click forces the other theme and persists it. CSS keys the active word
// off data-effective; the head init script in Base.astro has already set
// data-theme before first paint.
(function () {
	var btn = document.getElementById("theme-toggle");
	if (!btn) return;
	var mq = window.matchMedia("(prefers-color-scheme: dark)");
	var stored = null;
	try {
		stored = localStorage.getItem("theme");
	} catch (e) {}
	if (stored !== "light" && stored !== "dark") stored = null;
	var effective = function () {
		return stored || (mq.matches ? "dark" : "light");
	};
	var reflect = function () {
		var t = effective();
		btn.setAttribute("data-effective", t);
		btn.setAttribute(
			"aria-label",
			"Switch to " + (t === "dark" ? "light" : "dark") + " theme",
		);
	};
	btn.addEventListener("click", function () {
		stored = effective() === "dark" ? "light" : "dark";
		document.documentElement.setAttribute("data-theme", stored);
		try {
			localStorage.setItem("theme", stored);
		} catch (e) {}
		reflect();
	});
	// Track OS changes only while no explicit choice is stored.
	mq.addEventListener("change", function () {
		if (!stored) reflect();
	});
	reflect();
})();
  </script>
</Base>
