---
import { portfolio } from "../data/portfolio.ts";
import { course } from "../lib/course.ts";
import { isExternal } from "../lib/link.ts";
---

<div class="run" id="run" aria-label="Corgi Run" hidden>
  <div class="run-hud">
    <span class="run-title">Corgi Run</span>
    <span class="run-date" id="run-date" aria-hidden="true">Apr 2016</span>
    <span class="run-role" id="run-role" aria-hidden="true"></span>
    <span class="run-count" id="run-count" aria-hidden="true">0 / {course.items.length}</span>
    <span class="run-time" id="run-time" aria-hidden="true">0:00.0</span>
  </div>
  <div
    class="run-stage"
    id="run-stage"
    tabindex="0"
    aria-label="Corgi Run, a small game along the record above. Press Space to start and jump, arrow keys to look around."
    aria-describedby="run-hint"
  >
    <canvas
      id="run-game"
      role="img"
      aria-label="Drawing of a corgi on a road from April 2016 to now, with each role as a sign and each talk, article, paper, and award as a pickup"
    ></canvas>
    <div class="run-card" id="run-card-title">
      <p class="run-card-head">Ready</p>
      <p>Press Space or tap the road. Hold for a higher jump.</p>
    </div>
    <div class="run-card" id="run-card-pause" hidden>
      <p class="run-card-head">Paused</p>
      <p>Press Space or tap to keep running.</p>
    </div>
    <div class="run-card" id="run-card-end" hidden>
      <p class="run-card-head" id="run-end-head">Now</p>
      <p class="run-score" id="run-end-score"></p>
      <p class="run-card-links">
        {portfolio.links.map((link) => {
          const external = isExternal(link.href);
          return (
            <a
              href={link.href}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener" : undefined}
            >{link.label}</a>
          );
        })}
      </p>
    </div>
  </div>
  <canvas class="run-track" id="run-track" aria-hidden="true"></canvas>
  <div class="run-controls">
    <button class="run-button primary" id="run-main" type="button">Start</button>
    <button class="run-button" id="run-skip" type="button">Skip to now</button>
    <button class="run-button" id="run-reset" type="button" hidden>Clear progress</button>
    <span class="run-best" id="run-best"></span>
    <span class="run-hint" id="run-hint">Space or tap to jump · hold to go higher · drag or ← → to look around</span>
  </div>
  <p class="run-announce" id="run-announce" aria-live="polite"></p>
  <p class="run-pickup" id="run-pickup">
    <span class="run-pickup-kind">Pickups are checked off in the lists above.</span>
  </p>
  <script
    is:inline
    type="application/json"
    id="run-course"
    set:html={JSON.stringify(course)}
  />
</div>

<script>
import { startCorgiRun } from "../scripts/corgi-run.ts";

startCorgiRun();
</script>

<style>
.run {
  font-variant-numeric: tabular-nums;
}

.run-hud {
  display: grid;
  grid-template-columns: auto 4.5rem minmax(0, 1fr) auto auto;
  align-items: baseline;
  gap: 1rem;
}

.run-title {
  color: var(--text);
  font-weight: 500;
}

.run-role {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.run-count.done {
  color: var(--link);
}

.run-time {
  min-width: 3rem;
  text-align: right;
}

.run-stage {
  position: relative;
  height: 200px;
  margin-top: 0.25rem;
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
  cursor: pointer;
}

.run-stage.in-run:focus {
  outline: none;
}

.run-stage.grab {
  cursor: grabbing;
}

.run-stage canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.run-card {
  position: absolute;
  top: 0.25rem;
  right: 0;
  max-width: min(17.5rem, 100%);
  padding: 0.625rem 0.875rem;
  background: var(--background);
  border: 1px solid var(--line);
  border-radius: 2px;
  font-size: 0.8125rem;
  line-height: 1.6;
  cursor: default;
}

.run-card-head {
  color: var(--text);
  font-size: 0.875rem;
  font-weight: 600;
}

.run-score :global(strong) {
  color: var(--text);
  font-weight: 500;
}

.run-card-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0 0.875rem;
  margin-top: 0.25rem;
}

.run-card-links a {
  padding-block: 0.25rem;
}

.run-track {
  display: block;
  width: 100%;
  height: 30px;
  margin-top: 0.375rem;
  cursor: ew-resize;
  touch-action: none;
}

.run-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0 1.25rem;
}

.run-button {
  min-height: 2.75rem;
  padding: 0;
  border: 0;
  background: none;
  color: var(--muted);
  font-size: 0.75rem;
  cursor: pointer;
}

.run-button:hover {
  color: var(--text);
  text-decoration: underline;
  text-underline-offset: 0.2em;
}

.run-button.primary,
.run-button.primary:hover {
  color: var(--link);
}

.run-hint {
  margin-left: auto;
}

.run-announce {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.run-pickup {
  min-height: 3.4em;
  line-height: 1.7;
}

.run-pickup :global(.run-pickup-title) {
  color: var(--text);
}

@media (max-width: 480px) {
  .run-hud {
    grid-template-columns: auto 1fr auto auto;
    gap: 0.25rem 1rem;
  }

  .run-role {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .run-hint {
    width: 100%;
    margin-left: 0;
  }

  .run-card {
    top: 0;
    right: auto;
    left: 0;
  }
}
</style>
