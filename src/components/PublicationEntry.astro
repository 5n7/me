---
import type { PortfolioPublication } from "../data/portfolio.ts";
import { langOf } from "../lib/lang.ts";

type Props = PortfolioPublication & { runId: string };

const { title, venue, date, href, highlight, runId } = Astro.props;
---

<li class="publication-entry" data-run-id={runId}>
  <a
    class="publication-title"
    href={href}
    target="_blank"
    rel="noopener"
    lang={langOf(title)}
  >{title}</a>
  <p class="entry-details">
    <span lang={langOf(venue)}>{venue}</span>
    <span class="entry-date">{date}</span>
    {highlight && <span>{highlight}</span>}
  </p>
</li>
